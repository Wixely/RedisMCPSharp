<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The trim tier is about the shipped server, not the tests: IsTrimmable asserts something about
    an assembly that is never published, and the xunit runner is not trim-clean. Exempt opts this
    project out of the analysers; the reason is required by MCPFAB002.
  -->
  <PropertyGroup>
    <McpFabTrimPolicy>Exempt</McpFabTrimPolicy>
    <McpFabTrimExemptionReason>Test project. Never published, and the xunit runner is not trim-clean.</McpFabTrimExemptionReason>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../RedisMCPSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio"><PrivateAssets>all</PrivateAssets></PackageReference>
  </ItemGroup>

</Project>
