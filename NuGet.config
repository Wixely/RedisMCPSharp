<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      DnaX.MCPFab.* are published to GitHub Packages, which requires authentication even for
      public packages. CI injects GITHUB_TOKEN; local development needs a personal access token
      with read:packages exported as GITHUB_TOKEN once per machine. Without it, restore fails
      with "unable to load the service index", which does not name the cause.
    -->
    <add key="wixely-github" value="https://nuget.pkg.github.com/Wixely/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <wixely-github>
      <add key="Username" value="Wixely" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </wixely-github>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="wixely-github">
      <package pattern="DnaX.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
