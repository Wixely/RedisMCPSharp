<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Named to match the source in the developer's user-level NuGet.Config, so its stored
         credentials apply here (NuGet resolves credentials by source name). CI injects
         credentials for this name before restore. Never commit a token. -->
    <add key="GitHub-Wixely-Packages" value="https://nuget.pkg.github.com/Wixely/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Only Wixely-family packages hit the authenticated feed; everything else restores from
       nuget.org without needing feed credentials. A source with no pattern here is excluded
       from resolution entirely, which fails as a "package not found" rather than an auth error. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="GitHub-Wixely-Packages">
      <package pattern="DnaX.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
