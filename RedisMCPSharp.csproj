<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RedisMCPSharp</RootNamespace>
    <AssemblyName>RedisMCPSharp</AssemblyName>
    <ApplicationIcon>wmcp.ico</ApplicationIcon>
    <!--
      Analyzed, not Trimmed: the trim analyzers run and any regression is a build error, but
      this server still ships untrimmed until its ~86 anonymous-type serialization sites move
      to McpJson. Flipping to Trimmed before then would produce a server whose tools silently
      return {}.
    -->
    <!--
      Documentation only: Directory.Build.props is imported before this file, so the tiers keyed on
      McpFabTrimPolicy cannot see a value set here. The release pipeline passes it as a global
      property from its trim_policy input, which is the authority. Kept in step with that input so
      the two do not disagree; to build a tier locally, pass -p:McpFabTrimPolicy=Trimmed.
    -->
    <McpFabTrimPolicy>Trimmed</McpFabTrimPolicy>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Host, logging, auth and the MCP stack now arrive through MCPFab. -->
    <PackageReference Include="DnaX.MCPFab" />
    <PackageReference Include="DnaX.MCPFab.Build">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <None Update="RedisMCPSharp.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="RedisMCPSharp.*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <DependentUpon>RedisMCPSharp.json</DependentUpon>
    </None>
  </ItemGroup>

</Project>
