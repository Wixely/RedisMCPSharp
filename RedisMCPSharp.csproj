<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RedisMCPSharp</RootNamespace>
    <AssemblyName>RedisMCPSharp</AssemblyName>
    <ApplicationIcon>wmcp.ico</ApplicationIcon>
    <!--
      Analyzed, not Trimmed: the trim analyzers run and any regression is a build error, but
      this server still ships untrimmed until its ~86 anonymous-type serialization sites move
      to McpJson. Flipping to Trimmed before then would produce a server whose tools silently
      return {}.
    -->
    <!--
      McpFabTrimPolicy is deliberately NOT set here. Directory.Build.props is imported before this
      file, so a value set here cannot reach the tiers keyed on it - but DnaX.MCPFab.Build.targets
      is imported late enough to see it, and fails with MCPFAB004 when the two disagree. Setting it
      to Trimmed here broke the Docker build, which runs dotnet publish inside the image with no
      global property to match.

      The release pipeline's trim_policy input is the authority; it passes -p:McpFabTrimPolicy.
      To build a tier locally, pass the same flag: dotnet build -p:McpFabTrimPolicy=Trimmed.
    -->
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Host, logging, auth and the MCP stack now arrive through MCPFab. -->
    <PackageReference Include="DnaX.MCPFab" />
    <PackageReference Include="DnaX.MCPFab.Build">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <None Update="RedisMCPSharp.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="RedisMCPSharp.*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <DependentUpon>RedisMCPSharp.json</DependentUpon>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!--
      This csproj sits at the repository root, so the SDK's default **/*.cs glob reaches into
      tests/ and compiles the test sources into the server assembly - where xunit is not
      referenced, so they fail to build and the test project never gets its own compilation.
    -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <Content Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- RedisEndpoints is internal: it is an implementation detail of how this server renders a
         cluster endpoint, not API. Exposing it to the tests keeps it that way. -->
    <InternalsVisibleTo Include="RedisMCPSharp.Tests" />
  </ItemGroup>

</Project>
